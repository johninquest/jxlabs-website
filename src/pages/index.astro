---
import Layout from "../components/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="JohnX Labs - Digital Experiments, ..."
  description="JohnX Labs - Digital Experiments, Real Solutions."
>
  <Header slot="header" />

  <section class="hero">
    <div class="container">
      <p class="hero-subtitle">Digital Experiments, Real Solutions</p>
      <div class="hero-icon">
        <img
          src="/johnx-labs-flask.svg"
          alt="JohnX Labs experiment flask"
          width="120"
          height="120"
        />
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>

<style>
  .hero {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 70vh;
    text-align: center;
    padding: 4rem 1rem;
    background-color: var(--color-white);
  }

  .container {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-icon {
    margin-bottom: 2rem;
  }

  .hero-icon img {
    display: block;
    width: clamp(80px, 15vw, 140px);
    height: auto;
  }

  .hero-subtitle {
    font-size: clamp(1.25rem, 3vw, 1.5rem);
    font-weight: 400;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .hero {
      min-height: 75vh;
      padding: 6rem 2rem;
    }
  }

  @media (min-width: 1024px) {
    .hero {
      min-height: 80vh;
      padding: 8rem 3rem;
    }
  }
</style>
